{
    "name": "sql-evaluator",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "start": "npm run prod",
        "build": "npm-run-all clean transpile",
        "server": "node ./dist-server/bin/www.js",
        "dev": "NODE_ENV=development npm-run-all build server",
        "prod": "NODE_ENV=production npm-run-all build server",
        "transpile": "babel ./dev-server --out-dir dist-server",
        "clean": "rimraf dist-server",
        "watch:dev": "nodemon"
    },
    "babel": {
        "presets": [
            "@babel/preset-env"
        ]
    },
    "nodemonConfig": {
        "exec": "npm run dev",
        "watch": [
            "dev-server/*"
        ],
        "ignore": [
            "**/__tests__/**",
            "*.test.js",
            "*.spec.js",
            "public/zip/*"
        ]
    },
    "dependencies": {
        "@babel/cli": "^7.15.7",
        "@babel/core": "^7.15.8",
        "@babel/preset-env": "^7.15.8",
        "@babel/runtime": "^7.18.6",
        "axios": "^1.7.2",
        "cache": "^3.0.0",
        "consolidate": "^1.0.4",
        "cookie-parser": "~1.4.4",
        "debug": "~2.6.9",
        "evaluation-report-juezlti": "^1.0.6d",
        "express": "^4.21.2",
        "got": "^11.8.2",
        "http-errors": "~1.6.3",
        "json-to-markdown-table2": "^1.0.1",
        "morgan": "^1.10.1",
        "node-json2html": "^2.2.2",
        "nodemon": "^2.0.14",
        "npm-run-all": "^4.1.5",
        "pg": "^8.7.3",
        "programming-exercise-juezlti": "^1.1.8",
        "pug": "^3.0.2",
        "rimraf": "^6.0.1",
        "tabletojson": "^2.0.7",
        "temp": "^0.9.4",
        "url": "^0.11.0"
    },
    "devDependencies": {
        "@babel/plugin-transform-runtime": "^7.18.6",
        "babel-core": "^4.7.16",
        "babel-loader": "^8.2.5",
        "babel-polyfill": "^6.26.0",
        "babel-preset-env": "^1.7.0",
        "babel-preset-stage-0": "^6.24.1"
    }
}
